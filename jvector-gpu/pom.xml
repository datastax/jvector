<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="https://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jbellis</groupId>
        <artifactId>jvector-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>jvector-gpu</artifactId>
    <name>GPU graph build (TornadoVM + cuVS)</name>
    <description>
        A GraphBuildAccelerator that builds JVector graphs on NVIDIA GPUs with TornadoVM and NVIDIA cuVS.
        Built only with -Pgpu; run under the TornadoVM launcher with -Djvector.graph.accelerator=tornadovm.
    </description>

    <properties>
        <!-- TornadoVM 8.0.0 (released 2026-10-26): tornado-api and tornado-cuvs from Maven Central, the SDK of the same release at run time -->
        <tornadovm.version>8.0.0-jdk22plus</tornadovm.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.jbellis</groupId>
            <artifactId>jvector-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- provided: the benchmarks in io.github.jbellis.jvector.gpu.bench load datasets by name with the examples'
             DataSets; run.sh puts the examples jar on the class path -->
        <dependency>
            <groupId>io.github.jbellis</groupId>
            <artifactId>jvector-examples</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- provided: the TornadoVM SDK supplies these at run time, through the tornado launcher -->
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${tornadovm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-cuvs</artifactId>
            <version>${tornadovm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>22</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
