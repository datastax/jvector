# Server profile for jvector-examples/benchyaml-play.sh.
# Copy to bench-profiles/local/profile.env (ignored by git) and edit for your machine,
# or keep several in bench-profiles/local/<name>.env and select one with BENCH_PROFILE=<name>.

# JDK used to build and run BenchYAML.
BENCH_JDK=$HOME/.jdks/jdk-22.0.2+9

# Parent of each experiment's working directory (indexes, models, logs). Put it on fast local
# storage: queries read the index from here, including indexes that are not saved.
BENCH_WORK_ROOT=/data/jvector-bench

# Dataset catalogs, one per line: <catalog file> <directory holding its files>.
# Repository paths are relative to the checkout. Each catalog's ${JVECTOR_BENCH_DATA_DIR}
# is replaced by its directory. List each dataset name in only one catalog.
BENCH_CATALOGS="
jvector-examples/yaml-configs/ash-pq/catalog-large.yml /data/vectors/large
jvector-examples/yaml-configs/ash-pq/catalog-1m.yml /data/vectors/1m
"

# Optional. The JVM runs on one hardware thread of each of the first BENCH_CORES physical
# cores (default: all), with memory interleaved across BENCH_NODES (default: all NUMA nodes).
# The index YAML's construction.workers and search.workers set how many threads work.
#BENCH_CORES=48
#BENCH_NODES=0,1

# Optional. Where indexes that are not saved are written and reopened for queries
# (default: each experiment's tmp directory under BENCH_WORK_ROOT). Use fast local storage.
#BENCH_TMP_DIR=/data/jvector-bench/tmp

# Optional. Maximum Java heap (default 128g).
#BENCH_HEAP=128g
